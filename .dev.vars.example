# Copy to .dev.vars (gitignored) for `npm run dev` and the scripts, and fill in; the values are
# in 1Password. Production values are Worker secrets: `npx wrangler secret put <NAME>`.

# Better Auth. BETTER_AUTH_URL is a [vars] entry in wrangler.toml for production.
# A local signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:6712

# OAuth apps. Callback: {BETTER_AUTH_URL}/api/auth/callback/github (or /google)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects POST /api/notifications/check
CRON_SECRET=

# pgsites API (site database at pgsites.mckinleyaviation.com)
PGSITES_API_KEY=

# Optional: where the hourly health check emails failures and recoveries
HEALTH_ALERT_TO=

# Optional: openAIP API key for the map's Airspace layer (openaip.net, API Clients)
OPENAIP_API_KEY=

# Scripts only (scripts/seasons, scripts/staging.mjs): the Cloudflare API token
CLOUDFLARE_API_TOKEN=
